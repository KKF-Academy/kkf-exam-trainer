{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kkf-exam-trainer",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
